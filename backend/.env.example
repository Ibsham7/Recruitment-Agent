# ==============================================================================
# Backend Environment Configuration Template
# ==============================================================================

# Database Connection Strings (PostgreSQL / Supabase)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Redis Connection (Upstash / Local Redis for ARQ task queue)
REDIS_URL="redis://localhost:6379"
APP_ENV="development"
REDIS_DEV_URL="redis://localhost:6379"
ALLOW_REMOTE_REDIS_IN_DEV="false"
# true embeds one worker in the API; false selects standalone mode in Docker.
ENABLE_EMBEDDED_WORKER="true"
ARQ_ACTIVE_POLL_SECONDS="0.5"
ARQ_IDLE_POLL_SECONDS="30"
ARQ_ACTIVE_GRACE_SECONDS="5"
ARQ_ADAPTIVE_POLLING="true"
MAX_CONCURRENT_PIPELINES="3"

# LLM Providers (OpenRouter API Key)
OPENROUTER_API_KEY_PAID="sk-or-v1-your-openrouter-key"

# Supabase Auth & Security
FRONTEND_URL="http://localhost:5173"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Admin Access Control (Comma-separated list of admin emails)
ADMIN_EMAILS="admin@yourdomain.com,owner@yourdomain.com"

# Cloudflare R2 / AWS S3 Storage (For CVs & Presigned URLs)
R2_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="recruitment-agent-cvs"
R2_PUBLIC_URL_PREFIX="https://pub-xxxxxx.r2.dev"

# Email Service (Brevo / SMTP for Candidate Invitations)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="recruitment@yourcompany.com"
