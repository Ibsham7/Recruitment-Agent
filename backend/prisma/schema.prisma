datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
  previewFeatures      = ["postgresqlExtensions"]
}

model Campaign {
  id                String      @id @default(uuid())
  userId            String?     // Supabase Auth user ID
  title             String
  jobDescription    String
  distilledJd       String?
  jdEmbedding       Unsupported("vector(1536)")?
  canonicalJdSpec   Json?
  hardFiltersConfig Json?
  enableInterviews  Boolean     @default(true)
  interviewConfig   String?
  evaluationStrictness String   @default("moderate")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  candidates        Candidate[]

  // COST_TRACKING & TELEMETRY BREAKDOWN
  apiCost           Float       @default(0)
  costBreakdown     Json?

  @@index([userId])
}

model Candidate {
  id              String      @id @default(uuid())
  campaignId      String
  name            String
  email           String?
  phone           String?
  status          String      @default("pending") // pending, screening, screening_hold, shortlisted, invited, interviewing, interview_completed, finalized, rejected
  fitScore        Float?
  decision        String?     // final decision by recruiter: approve, reject, hold
  rejectionReason String?
  totalExperienceYears Float?
  currentRole          String?
  skills          String[]
  education       String[]
  cvUrl           String?
  invitedAt       DateTime?
  invitationToken String?
  
  // R3 Compliance & Consent Fields
  consentGivenAt             DateTime?
  termsVersionAgreed         String?
  privacyPolicyVersionAgreed String?
  
  resumeId        String?
  resume          Resume?     @relation(fields: [resumeId], references: [id])
  
  campaign        Campaign    @relation(fields: [campaignId], references: [id])
  evaluation      Evaluation?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // COST_TRACKING & TELEMETRY BREAKDOWN
  apiCost         Float       @default(0)
  costBreakdown   Json?


  @@index([campaignId])
  @@index([resumeId])
  @@index([campaignId, status])
  @@index([createdAt])
  @@index([updatedAt])
}

model Resume {
  id                String      @id @default(uuid())
  fileHash          String      @unique
  structuredProfile Json?
  rawCvText         String?
  embedding         Unsupported("vector(1536)")?
  
  candidates        Candidate[]
  
  createdAt         DateTime    @default(now())
}

model Evaluation {
  id                  String    @id @default(uuid())
  candidateId         String    @unique
  overallScore        Float
  technicalScore      Float?
  communicationScore  Float?
  culturalFitScore    Float?
  recommendation      String
  summary             String
  strengths           String[]
  concerns            String[]
  scoreBreakdown      Json?
  chainOfThought      String?
  interviewTranscript Json?
  interviewQuestions  Json?
  aiGeneratedLikelihoodScore Float?   @default(0.0)
  antiCheatFlags      Json?
  antiCheatMetadata   Json?
  
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime  @default(now())
}

model CandidateAnalytics {
  id              String   @id @default(uuid())
  campaignId      String
  campaignTitle   String
  status          String
  fitScore        Float?
  overallScore    Float?
  exitStage       String?
  createdAt       DateTime @default(now())

  @@index([campaignId])
}

model FaqQuestion {
  id               String   @id @default(uuid())
  category         String   // e.g., Screening Engine, Interview Workflows, Data Privacy, System Integration, Enterprise Onboarding
  question         String
  contextDetails   String?
  company          String?
  role             String?
  candidateVolume  String?  // e.g., 1-50, 50-500, 500+ candidates/mo
  urgency          String   @default("medium") // low, medium, high, critical
  name             String
  email            String
  preferredContact String   @default("email") // email, call, async
  status           String   @default("pending") // pending, answered, archived
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

model UserProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  email                 String
  plan                  String              @default("free") // "free" | "paid"
  creditBalance         Int                 @default(0)
  totalCvsProcessed     Int                 @default(0)
  totalCampaignsCreated Int                 @default(0)
  totalInterviewsSent   Int                 @default(0)
  creditRequests        CreditRequest[]
  creditTransactions    CreditTransaction[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId])
  @@index([email])
  @@index([plan])
}

model CreditRequest {
  id               String      @id @default(uuid())
  userId           String
  amount           Float
  screenshotUrl    String
  status           String      @default("pending") // "pending" | "approved" | "rejected"
  rejectionReason  String?
  creditsAllocated Int         @default(0)
  reviewedBy       String?
  reviewedAt       DateTime?
  user             UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model CreditTransaction {
  id              String      @id @default(uuid())
  userId          String
  type            String      // "purchase" | "debit_campaign" | "debit_cv" | "debit_invite" | "debit_evaluation" | "refund" | "admin_adjustment"
  credits         Int
  description     String
  relatedEntityId String?
  user            UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
